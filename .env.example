# Copy to repo root as `.env` and adjust values.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173

# Database: omit to use SQLite (`backend/zoning_dev.db`). For Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://zoning:zoning@localhost:5432/zoning_dev

# Redis (Celery / cache)
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=zoning_chunks

# Object storage (optional; MinIO in docker-compose)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio12345
# S3_BUCKET=zoning-assets

# PDF OCR (PyMuPDF + Tesseract). Install Tesseract and language data for OCR paths.
# PDF_OCR_ENABLED=true
# PDF_OCR_MIN_NATIVE_CHARS=50
# PDF_OCR_DPI=150
# PDF_OCR_LANGUAGE=eng
# PDF_OCR_PARTIAL=false

# LLM (optional until you wire LangChain)
# OPENAI_API_KEY=

# LangSmith / LangChain tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=zoning-app
# LANGSMITH_API_KEY=

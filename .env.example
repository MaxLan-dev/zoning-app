# Copy to repo root as `.env` and adjust values.
# Optional: `.env.local` (gitignored) is loaded after `.env` and overrides keys.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173

# Database: omit to use SQLite (`backend/zoning_dev.db`). For Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://zoning:zoning@localhost:5432/zoning_dev

# Redis (Celery / cache)
REDIS_URL=redis://localhost:6379/0

# Qdrant (required for PDF vector upload)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=zoning_chunks

# Groq (RAG answers) — https://console.groq.com/
GROQ_API_KEY=
# Default chat model for POST /api/v1/rag
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings: local sentence-transformers model (no OPENAI_API_KEY)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# MAX_UPLOAD_MB=32

# Object storage (optional; MinIO in docker-compose)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio12345
# S3_BUCKET=zoning-assets

# LangSmith tracing (optional). LANGSMITH_API_KEY is copied to LANGCHAIN_API_KEY on startup.
# LANGCHAIN_PROJECT=zoning-app
LANGSMITH_API_KEY=
